{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["ASTRO_TELEMETRY_DISABLED", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        "../../apps/blog/public/labs/**"
      ]
    },
    "blog#build": {
      "dependsOn": ["@labs/iptv#build", "@labs/globe#build"],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
