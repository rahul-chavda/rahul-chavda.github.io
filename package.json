{
  "name": "rahul-chavda-monorepo",
  "private": true,
  "packageManager": "npm@12.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "labs/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=blog",
    "watch:iptv": "turbo run dev:watch --filter=@labs/iptv",
    "watch:globe": "turbo run dev:watch --filter=@labs/globe",
    "dev:iptv": "turbo run dev --filter=@labs/iptv",
    "dev:globe": "turbo run dev --filter=@labs/globe",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf .turbo"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  }
}
