{
  "name": "rahul-chavda-monorepo",
  "private": true,
  "packageManager": "npm@12.2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "labs/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=blog",
    "dev:iptv": "npm run dev --workspace=labs/iptv",
    "dev:globe": "npm run dev --workspace=labs/globe",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf apps/blog/dist apps/blog/public/labs"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.8.0"
  }
}
